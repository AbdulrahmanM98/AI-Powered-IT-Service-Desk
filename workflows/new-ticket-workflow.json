        "builtInTools": {},
        "options": {
          "temperature": 0.1
        }
      },
      "id": "e6a81457-6f7e-4953-a097-a9da69923608",
      "name": "OpenAI Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        544,
        512
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \"priority\": \"Critical\", \"ai_summary\": \"وصف مختصر ودقيق للمشكلة التقنية مع السبب المحتمل\" }"
      },
      "id": "88649053-3ac9-4c98-bfc7-3439b0593edd",
      "name": "Ticket Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        704,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || {};\nconst priority = raw.priority || 'Medium';\nconst summary = raw.ai_summary || '';\n\nconst priorityMap = {\n  Critical: { hours: 1, labelAr: 'حرج', slaTextAr: 'خلال ساعة واحدة' },\n  High: { hours: 4, labelAr: 'عالي', slaTextAr: 'خلال 4 ساعات' },\n  Medium: { hours: 24, labelAr: 'متوسط', slaTextAr: 'خلال يوم عمل واحد' },\n  Low: { hours: 72, labelAr: 'منخفض', slaTextAr: 'خلال 3 أيام عمل' }\n};\n\nconst conf = priorityMap[priority] || priorityMap.Medium;\nconst now = new Date();\nconst deadline = new Date(now.getTime() + conf.hours * 60 * 60 * 1000);\nconst ticketId = 'TKT-' + now.getTime();\n\nreturn [{\n  json: {\n    ticket_id: ticketId,\n    priority: priority,\n    priority_ar: conf.labelAr,\n    sla_text_ar: conf.slaTextAr,\n    sla_deadline: deadline.toISOString(),\n    ai_summary: summary\n  }\n}];"
      },
      "id": "34eab5a2-999b-452e-98b2-b8275cb36928",
      "name": "Calculate SLA & Ticket ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
